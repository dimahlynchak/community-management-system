DATABASE_URL=postgresql://postgres:your_password@localhost:5432/community_db
SECRET_KEY=secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies refresh-токена. Для локального http лиши False; у продакшні з https — True.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Ставки пені (на день, як частка від боргу).
# PENALTY_DAILY_RATE — значення за замовчуванням, якщо в запиті не вказано rate.
# MAX_DAILY_PENALTY_RATE — верхня межа згідно зі ст. 3 ЗУ «Про відповідальність
#   за несвоєчасне виконання грошових зобов'язань»: 2 × облікова ставка НБУ / 365.
#   Значення 0.00137 відповідає ставці НБУ ~25 %.
PENALTY_DAILY_RATE=0.001
MAX_DAILY_PENALTY_RATE=0.00137
